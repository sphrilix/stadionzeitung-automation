load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "bfv-miner_lib",
    srcs = [
        "config.go",
        "fupa.go",
        "main.go",
    ],
    importpath = "github.com/sphrilix/stadionzeitung-automation/cmd/bfv-miner",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/bfv",
        "//internal/fupa",
        "//internal/render",
    ],
)

go_binary(
    name = "bfv-miner",
    embed = [":bfv-miner_lib"],
    visibility = ["//visibility:public"],
    x_defs = {"main.version": "{STABLE_VERSION}"},
)

go_test(
    name = "bfv-miner_test",
    srcs = [
        "config_test.go",
        "fupa_test.go",
    ],
    embed = [":bfv-miner_lib"],
    deps = ["//internal/fupa"],
)
